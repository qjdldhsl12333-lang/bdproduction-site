APP_ENV=production

# 데이터베이스 설정
# 클라우드웨이즈 데이터 베이스 
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bdproduction
DB_USER=bdproduction_user
DB_PASS=
#DB_HOST=Cloudways_DB_HOST
#DB_NAME=Cloudways_DB_NAME
#DB_USER=Cloudways_DB_USER
#DB_PASS=Cloudways_DB_PASSWORD

# CORS_ALLOWED_ORIGINS=https://bdproduction.co.kr,https://www.bdproduction.co.kr

# 관리자 계정
# 
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_LIFETIME_SECONDS=7200

ADMIN_LOGIN_MAX_ATTEMPTS=5
# ADMIN_LOGIN_LOCK_SECONDS=900
ADMIN_UNLOCK_CODE_EXPIRES_SECONDS=600
ADMIN_SECURITY_ALERT_TO_ADDRESS=qkdldhsl123@naver.com

#예약 메일 발송
MAIL_ENABLED=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=tls
MAIL_USERNAME=mbdasd@bdproduction.co.kr
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=mbdasd@bdproduction.co.kr
MAIL_FROM_NAME=BDPRODUCTION
MAIL_TO_ADDRESS=mbdasd@bdproduction.co.kr,qkdldhsl123@naver.com

#유튜브 API 설정
YOUTUBE_ENABLED=false
YOUTUBE_API_KEY=
YOUTUBE_PLAYLIST_ID=
YOUTUBE_MAX_RESULTS=6
YOUTUBE_NEW_DAYS=7

YOUTUBE_SYNC_TOKEN=

# Contact spam protection
CONTACT_MAX_ATTEMPTS=5
CONTACT_RATE_LIMIT_SECONDS=600
CONTACT_MESSAGE_MIN_LENGTH=5
CONTACT_MESSAGE_MAX_LENGTH=2000

# Notion
NOTION_ENABLED=false
NOTION_API_TOKEN=your_notion_integration_token
NOTION_VERSION=2026-03-11

# Use data_source_id for latest Notion API.
# If your Notion setup only provides a database_id, set NOTION_CONTACTS_PARENT_TYPE=database_id.
NOTION_CONTACTS_PARENT_TYPE=data_source_id
NOTION_CONTACTS_PARENT_ID=your_notion_contacts_data_source_or_database_id

# Customer account / Phase 2 auth scaffold
CUSTOMER_SESSION_LIFETIME_SECONDS=1209600

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8080/api/auth/kakao/callback.php

NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_REDIRECT_URI=http://localhost:8080/api/auth/naver/callback.php

GOOGLE_CLIENT_ID=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback.php
#GOOGLE_REDIRECT_URI=https://bdproduction.co.kr/api/auth/google/callback.php

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173